# --- Required ---------------------------------------------------------------
# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret callers must send as the X-API-Key header.
# Leave empty ONLY if the service is not reachable from the internet.
APP_API_KEY=change-me-to-a-long-random-string

# --- Model -----------------------------------------------------------------
# The model that does the rewriting. Change it here and redeploy, or override
# per call with the "model" field in the request body.
# Also readable as ANTHROPIC_MODEL, if that name is easier to find in a long
# EasyPanel env list. If both are set, MODEL wins.
#   claude-opus-5     $5/$25  per Mtok  - best style-instruction adherence
#   claude-sonnet-5   $3/$15            - ~40% cheaper, slightly looser rhythm
#   claude-haiku-4-5  $1/$5             - cheapest; expect to raise MAX_ATTEMPTS
#   claude-opus-4-8   $5/$25            - previous Opus generation
MODEL=claude-opus-5

# Reasoning depth. low | medium | high | xhigh | max
# Also readable as ANTHROPIC_EFFORT. Overridable per call with "effort".
# Below "high" the sentence-rhythm rules get followed loosely.
EFFORT=high
MAX_TOKENS=16000
ENABLE_REFUSAL_FALLBACK=true
REQUEST_TIMEOUT_SECONDS=600

# --- Pipeline --------------------------------------------------------------
# Composite AI-likelihood target, 0-100. Lower is stricter.
TARGET_AI_SCORE=10
# Rewrite attempts per section before accepting the best result so far.
MAX_ATTEMPTS=3
# Editing aggressiveness: standard | aggressive | max.
#   standard   - one structure-preserving pass (default).
#   aggressive - one hard pass, extra human-texture instructions, lower target.
#   max        - aggressive + a second texture pass that adds human irregularity.
# Helps most against perplexity/burstiness checkers; gains against trained
# classifiers (Copyleaks, TruthScan) are modest. Overridable per request.
STRENGTH=standard
# Full pipeline passes (1-3). 0 = derive from STRENGTH (max => 2, else 1).
# Each extra pass compounds cost and fact-drift risk. Overridable per request.
PASSES=0
CHUNK_TARGET_WORDS=700
CHUNK_MAX_WORDS=1000
ENABLE_POSTPROCESS=true
# Sections rewritten in parallel.
CONCURRENCY=3

# --- Guidance detector (the part that moves trained classifiers) ------------
# A real neural detector, run locally on CPU, used as the optimisation target
# for the adversarial pass. This is what makes the difference against GPTZero /
# Copyleaks; the stylometric proxy alone does not move them.
#   local  run the model below  (needs the detector-enabled image, ~2GB RAM)
#   none   fall back to the stylometric proxy (no torch, ~512MB RAM)
GUIDANCE_DETECTOR=local

# The model must AGREE with the detector that gates your publishing, or the
# adversarial pass optimises a target your detector does not share. Verify with:
#   python scripts/detector_check.py --file flagged.md --expect ai
# Measured on a real pipeline output that GPTZero and Copyleaks both scored 100% AI:
#   desklib/ai-text-detector-v1.01                 0.76  AGREES  <- default
#   fakespot-ai/roberta-base-ai-text-detection-v1  0.003 DISAGREES (useless as a guide)
GUIDANCE_MODEL=desklib/ai-text-detector-v1.01
GUIDANCE_BATCH_SIZE=16
# 0 lets torch decide. Set to 1-2 on a small shared droplet.
GUIDANCE_THREADS=0
# Load weights at boot instead of on the first request. Costs ~40s of startup,
# saves the first caller from paying it.
GUIDANCE_WARMUP=false

# --- Adversarial pass ------------------------------------------------------
# Detector-guided sentence substitution, after the rewrite passes. Only ever
# swaps one sentence for another inside a paragraph, so it cannot break the
# heading or list structure.
ENABLE_ADVERSARIAL=true
ADVERSARIAL_ROUNDS=3
ADVERSARIAL_CANDIDATES=4
ADVERSARIAL_SENTENCES_PER_ROUND=12
# Stop once the guidance detector reports this probability or lower (0.0-1.0).
ADVERSARIAL_TARGET_PROBABILITY=0.25
# Only rewrite sentences the detector is at least this suspicious of.
ADVERSARIAL_MIN_SENTENCE_PROBABILITY=0.35

# --- Server ---------------------------------------------------------------
PORT=8000
LOG_LEVEL=info
